#!/usr/bin/env bash
set -euo pipefail

module_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
rust_command="${module_root}/target/debug/jiritsu-stated"

if [[ "${JIRITSU_STATED_IMPLEMENTATION:-auto}" != "python" && -x "$rust_command" ]]; then
  exec "$rust_command" "$@"
fi

exec "${module_root}/bin/jiritsu-stated-python" "$@"
